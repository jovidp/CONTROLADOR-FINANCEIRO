# Copie para .env e preencha. O .env NUNCA vai para o git (veja o .gitignore).
#
# ATENCAO: nao use "#" dentro de valores aqui — o dotenv trata como comentario.

# --- Conexao da aplicacao com o PostgreSQL ---------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=controlador_financeiro
PGUSER=fin_app
PGPASSWORD=troque-esta-senha

# --- Superusuario ----------------------------------------------------
# Usado APENAS pelo `npm run db:create`, para criar o database e a role.
# A aplicacao em si nunca usa isto: ela roda com a role acima, que nao e
# superusuario.
PG_SUPERUSER=postgres
PG_SUPERPASSWORD=senha-do-postgres

# --- Servidor --------------------------------------------------------
PORT=3001

# Endereco em que o servidor escuta. Deixe VAZIO (padrao 127.0.0.1).
#
# O bind local NAO tem HTTPS -- o TLS so existe na ponta do Tailscale. Com
# HOST=0.0.0.0, qualquer maquina da rede abre http://<ip-desta-maquina>:PORT e a
# SENHA de quem entrar por ali viaja em TEXTO CLARO pelo cabo.
#
# Em 127.0.0.1 nao se perde acesso remoto: o Tailscale (Serve e Funnel) faz proxy
# a partir do loopback, entao tailnet e internet continuam funcionando -- com TLS.
# Para chegar de outra maquina, use o nome do Tailscale, nao o IP da LAN.
HOST=

# --- Login -----------------------------------------------------------
# Deixe VAZIO num projeto novo: o primeiro acesso cria o usuario pelo navegador,
# e a senha vai para o banco (hash scrypt), nao para este arquivo.
#
# As tres variaveis abaixo existem so para instalacoes antigas, anteriores ao
# cadastro pelo navegador. Se voce as preencher (com `npm run senha`), o usuario
# correspondente e criado/atualizado no banco quando o servidor sobe.
AUTH_USUARIO=
AUTH_SENHA_HASH=

# Assina o cookie de sessao (HMAC-SHA256). Gere um valor aleatorio proprio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Vazio, o servidor sorteia um segredo temporario a cada boot — as sessoes
# continuam seguras, mas todo mundo e deslogado quando o servidor reinicia.
SESSION_SECRET=

# --- Backups ---------------------------------------------------------
# Cifra os arquivos de backups/ com AES-256-GCM (veja src/cripto.js). O dump e o
# unico lugar onde os seus dados saem da maquina inteiros, num arquivo so.
#
# Gere um valor aleatorio proprio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Tambem cifra os segredos de 2FA (TOTP) guardados no banco: com esta chave, um
# dump do banco SEM o .env nao entrega os segredos do autenticador.
#
# GUARDE UMA COPIA FORA DESTA MAQUINA. Sem esta chave, nenhum backup existente pode
# ser restaurado — nem por voce — e os segredos de 2FA ja gravados nao decifram.
#
# Vazia, backups e segredos de 2FA ficam em TEXTO CLARO. So e aceitavel se nada disso
# sai daqui.
BACKUP_CHAVE=

# --- Cadastro --------------------------------------------------------
# Codigo de convite. Preenchido, o cadastro EXIGE este codigo: ninguem cria conta
# sem ele. Entregue o codigo so a quem for usar o app. Essencial quando o app fica
# exposto na internet (Tailscale Funnel) -- senao qualquer um cria conta no seu banco.
#
# Gere um:  node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
#
# Vazio, o cadastro fica ABERTO (ok atras do tailnet/localhost; nao no Funnel).
CADASTRO_CONVITE=
