PGHOST=localhost
PGPORT=5432
PGDATABASE=controlador_financeiro
PGUSER=fin_app
PGPASSWORD=troque-me

PG_SUPERUSER=postgres
PG_SUPERPASSWORD=troque-me

PORT=3001

# Login do app. NAO preencha na mao: rode `npm run senha`, que pergunta usuario e
# senha e grava as tres linhas abaixo (a senha vira um hash scrypt; o texto puro
# nao e gravado em lugar nenhum). Sem elas, o servidor se recusa a subir.
AUTH_USUARIO=
AUTH_SENHA_HASH=
SESSION_SECRET=
